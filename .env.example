# Copy this file to .env and fill in your key.
# Get an Anthropic API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional - defaults to 3737
PORT=3737

# Folder for CSV backups (manual Export button + auto-export).
# Absolute path or ~/... is fine. Defaults to ./exports in this folder.
# EXPORT_DIR=/Users/you/Documents/Arabic vocab backups
